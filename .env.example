# Copy to .env and fill in. .env is git-ignored; NEVER put real keys in this example file.
# Variables already set in your shell take precedence over this file.
# Only one provider is active at a time: edit the three OPENAI_* values below.

# --- DeepSeek (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# --- Gemini via its OpenAI-compatible endpoint: uncomment these and comment out the block above ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash   # check the current model name in Google's docs

# --- OpenRouter: one key, many models; switch by changing OPENAI_MODEL only ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=   # pick a model that supports tool calling; see openrouter.ai/models
